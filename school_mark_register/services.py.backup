# ========================================================================
# Exam Component Service
# ========================================================================

class ExamComponentService:
    def __init__(self, session: Session):
        self.session = session
        self.repo = ExamComponentRepository(session)

    def add_component(
        self,
        exam_type_id: int,
        name: str,
        code: str,
        max_marks: int,
        subject_id: int | None = None,
        display_order: int | None = None,
        is_active: bool = True,
    ) -> ExamComponent:
        name = (name or "").strip()
        code = (code or "").strip().upper()
        if not name:
            raise ValueError("Component name is required")
        if not code:
            raise ValueError("Component code is required")
        if max_marks <= 0:
            raise ValueError("Max marks must be positive")
        if self.repo.exists_by_name(exam_type_id, name, subject_id, exclude_id=None):
            raise ValueError(f"Component '{name}' already exists for this exam type")
        
        if display_order is None:
            existing = self.repo.get_by_exam_type(exam_type_id)
            display_order = max([c.display_order for c in existing], default=0) + 1
        
        component = ExamComponent(
            exam_type_id=exam_type_id,
            subject_id=subject_id,
            name=name,
            code=code,
            max_marks=max_marks,
            display_order=display_order,
            is_active=is_active,
        )
        try:
            self.repo.add(component)
            self.session.commit()
        except Exception:
            self.session.rollback()
            raise
        return component

    def update_component(
        self,
        component_id: int,
        name: Optional[str] = None,
        code: Optional[str] = None,
        max_marks: Optional[int] = None,
        display_order: Optional[int] = None,
        is_active: Optional[bool] = None,
    ) -> ExamComponent:
        component = self.repo.get(component_id)
        if component is None:
            raise ValueError("Component not found")
        
        if name is not None:
            name = name.strip()
            if not name:
                raise ValueError("Component name is required")
            if self.repo.exists_by_name(component.exam_type_id, name, component.subject_id, exclude_id=component_id):
                raise ValueError(f"Component '{name}' already exists")
            component.name = name
        
        if code is not None:
            code = code.strip().upper()
            if not code:
                raise ValueError("Component code is required")
            component.code = code
        
        if max_marks is not None:
            if max_marks <= 0:
                raise ValueError("Max marks must be positive")
            component.max_marks = max_marks
        
        if display_order is not None:
            if display_order < 0:
                raise ValueError("Display order must be non-negative")
            component.display_order = display_order
        
        if is_active is not None:
            component.is_active = is_active
        
        try:
            self.session.commit()
        except Exception:
            self.session.rollback()
            raise
        return component

    def delete_component(self, component_id: int) -> bool:
        component = self.repo.get(component_id)
        if component is None:
            raise ValueError("Component not found")
        try:
            self.repo.delete(component)
            self.session.commit()
        except Exception:
            self.session.rollback()
            raise
        return True

    def list_components(self, exam_type_id: int) -> List[ExamComponent]:
        return self.repo.get_by_exam_type(exam_type_id)

    def list_components_for_subject(self, exam_type_id: int, subject_id: int) -> List[ExamComponent]:
        return self.repo.get_by_exam_type_and_subject(exam_type_id, subject_id)

    def reorder_components(self, exam_type_id: int, component_orders: List[Tuple[int, int]]) -> None:
        try:
            for component_id, new_order in component_orders:
                if new_order < 0:
                    raise ValueError("Display order must be non-negative")
                component = self.repo.get(component_id)
                if component is None:
                    raise ValueError(f"Component {component_id} not found")
                component.display_order = new_order
            self.session.commit()
        except Exception:
            self.session.rollback()
            raise

    def bulk_import(
        self,
        exam_type_id: int,
        subject_id: int | None,
        components: List[dict],
        skip_duplicates: bool = True,
    ) -> Tuple[List[ExamComponent], List[str]]:
        created = []
        errors = []
        for idx, comp in enumerate(components):
            name = (comp.get("name") or "").strip()
            code = (comp.get("code") or "").strip().upper()
            if not name:
                errors.append(f"Row {idx + 1}: Empty name skipped")
                continue
            if not code:
                errors.append(f"Row {idx + 1} ({name}): Empty code skipped")
                continue
            if self.repo.exists_by_name(exam_type_id, name, subject_id):
                if skip_duplicates:
                    errors.append(f"Row {idx + 1} ({name}): Duplicate skipped")
                    continue
                else:
                    errors.append(f"Row {idx + 1} ({name}): Duplicate")
                    continue
            try:
                c = self.add_component(
                    exam_type_id=exam_type_id,
                    name=name,
                    code=code,
                    max_marks=comp.get("max_marks", 0),
                    subject_id=subject_id,
                    is_active=comp.get("is_active", True),
                )
                created.append(c)
            except Exception as exc:
                errors.append(f"Row {idx + 1} ({name}): {exc}")
        return created, errors

    def export_components_to_csv(self, exam_type_id: int, subject_id: int | None = None) -> str:
        import csv
        from io import StringIO
        output = StringIO()
        writer = csv.writer(output)
        writer.writerow(["Name", "Code", "Max Marks", "Display Order", "Active"])
        for c in self.list_components_for_subject(exam_type_id, subject_id) if subject_id else self.list_components(exam_type_id):
            writer.writerow([c.name, c.code, c.max_marks, c.display_order, "Yes" if c.is_active else "No"])
        return output.getvalue()