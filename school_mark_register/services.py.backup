        return result

    # ------------------------------------------------------------------ audit

    def _log_audit(
        self,
        component_marks: ComponentMarks,
        field_changed: str,
        old_value: str | None,
        new_value: str | None,
        old_status: str | None,
        new_status: str | None,
        action: str,
        user_id: int | None = None,
        user_name: str | None = None,
        component_name: str | None = None,
        component_code: str | None = None,
        conversion_applied: bool = False,
        conversion_formula: str | None = None,
    ) -> MarksAuditLog:
        """Create an audit log entry for a component marks change with component-specific details."""
        audit = MarksAuditLog(
            marks_id=component_marks.id,
            student_id=component_marks.student_id,
            subject_id=component_marks.subject_id,
            exam_type_id=component_marks.exam_type_id,
            session_id=component_marks.session_id,
            class_id=component_marks.class_id,
            section_id=component_marks.section_id,
            field_changed=field_changed,
            old_value=old_value,
            new_value=new_value,
            old_status=old_status,
            new_status=new_status,
            user_id=user_id,
            user_name=user_name,
            action=action,
        )
        # Add component-specific audit info in the field_changed or as JSON in a custom field
        # For now, store component-specific info in the field_changed and old/new values
        if component_marks.component:
            audit.field_changed = f"{component_marks.component.code}: {field_changed}"
            if component_name:
                audit.old_value = f"[{component_name}] {old_value or ''}"
                audit.new_value = f"[{component_name}] {new_value or ''}"
        
        # Store conversion info in old_value/new_value if conversion was applied
        if conversion_applied and conversion_formula:
            audit.old_value = f"{audit.old_value or ''} | Conversion: {conversion_formula}"
        
        from repositories import MarksAuditLogRepository
        audit_repo = MarksAuditLogRepository(self.session)
        audit_repo.add(audit)
        return audit

        return result

